{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --strictPort",
      "startServerReadyPattern": "Local",
      "url": ["http://127.0.0.1:4173/", "http://127.0.0.1:4173/t/00000000-0000-4000-8000-0000000000f1"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "disableStorageReset": false
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000, "aggregationMethod": "median" }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 153600, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
